# =====================================================================
# PersonaLearn server configuration
# .env holds real secrets and is gitignored. .env.example is the
# committed template with the same keys and no secret values.
# =====================================================================

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- MongoDB (required for Milestone 1) ---
# Local install:  mongodb://localhost:27017
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=personalearn

# --- Auth ---
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Provider switches (fake/local/console = no account needed) ---
STORAGE_BACKEND=local
AI_PROVIDER=fake
EMAIL_BACKEND=console
VIDEO_PROVIDER=fake

# --- Gemini (Google AI Studio) - needed when AI_PROVIDER=gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Cloudinary - needed when STORAGE_BACKEND=cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend - needed when EMAIL_BACKEND=resend ---
RESEND_API_KEY=
EMAIL_FROM=

# --- HeyGen - needed when VIDEO_PROVIDER=heygen ---
HEYGEN_API_KEY=
HEYGEN_WEBHOOK_SECRET=
HEYGEN_TEST_MODE=true

# --- Redis - needed later for the production job queue ---
REDIS_URL=

# --- AI generation limits ---
MAX_MODULES=2
MAX_LESSONS_PER_MODULE=3

# --- Verification / password reset ---
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=30

# --- Logging ---
# Files: logs/app.log (everything) and logs/errors.log (warnings + errors). Rotate at 5 MB.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true

# --- Abuse protection (per-IP request limits on auth endpoints) ---
RATE_LIMIT_ENABLED=true

# --- Tests (optional) ---
# Database tests use TEST_MONGO_URI if set, else MONGO_URI, always with the separate
# database "personalearn_test". Set this as a shell environment variable, not required here.
# TEST_MONGO_URI=
